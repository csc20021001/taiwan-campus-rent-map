# Optional: use your own PMTiles archive (Cloudflare R2 custom domain is recommended for production).
NEXT_PUBLIC_PMTILES_URL=https://data.source.coop/protomaps/openstreetmap/v4.pmtiles

# Optional: AdSense stays as a labelled placeholder until both values are valid.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT=

# Google Cloud Console → OAuth 2.0 Web application.
# Local redirect URI: http://localhost:3000/api/auth/google/callback
# Production redirect URI: https://scmwcscr.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
