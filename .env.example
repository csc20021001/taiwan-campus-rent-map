# Optional overrides. The verified publisher ID has a checked-in public fallback;
# the reserved placement stays empty until a numeric ad-unit slot is available.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT=

# Google Cloud Console → OAuth 2.0 Web application.
# Local redirect URI: http://localhost:3000/api/auth/google/callback
# Production redirect URI: https://map.scmwcscr.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
